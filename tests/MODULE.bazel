module(name = "score_rules_imagefs_tests")

# *******************************************************************************
# Common useful functions and rules for Bazel
# *******************************************************************************
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# *******************************************************************************
# Constraint values for specifying platforms and toolchains
# *******************************************************************************
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "score_bazel_platforms", version = "1.0.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

# *******************************************************************************
# C++ Rules for Bazel
# *******************************************************************************
bazel_dep(name = "rules_cc", version = "0.2.17")

# *******************************************************************************
# Hermetic `truncate` used by the ext4 rule, via bazel_lib's coreutils toolchain
# (prebuilt uutils/coreutils binaries, no host tool required).
# *******************************************************************************
bazel_dep(name = "bazel_lib", version = "3.7.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "score_rules_imagefs")
local_path_override(
    module_name = "score_rules_imagefs",
    path = "../",
)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_qnx_x86_64_ext4_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    type = "ext4",
)
use_repo(imagefs, "score_qnx_x86_64_ext4_toolchain")
